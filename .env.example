# ==============================================================================
# AI RECRUITER ASSISTANT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- APPLICATION ENVIRONMENT ---
# Options: development, production
ENVIRONMENT=development

# --- DATABASE CONFIGURATION ---
# LOCAL DEVELOPMENT (Leave DATABASE_HOST empty to use SQLite automatically):
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=recruiter_db
DATABASE_USER=postgres
DATABASE_PASSWORD=

# AWS PRODUCTION (Amazon RDS PostgreSQL):
# DATABASE_HOST=ai-recruiter-postgres.cxxxxxxxxx.us-east-1.rds.amazonaws.com
# DATABASE_PORT=5432
# DATABASE_NAME=recruiter_db
# DATABASE_USER=dbadmin
# DATABASE_PASSWORD=YourStrongMasterPassword123!
# Or full connection string:
# DATABASE_URL=postgresql://dbadmin:YourStrongMasterPassword123!@ai-recruiter-postgres.cxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/recruiter_db

# --- AMAZON S3 STORAGE CONFIGURATION ---
# AWS Region where resources are provisioned
AWS_REGION=us-east-1

# S3 Bucket Name for private resume storage (leave empty to use local data/resumes fallback)
# In production on AWS EC2, the IAM role attached to EC2 provides credentials automatically.
S3_BUCKET_NAME=
# S3_BUCKET_NAME=ai-recruiter-resumes-prod-2026

# Pre-signed URL expiration in seconds (default 3600 = 1 hour)
S3_PRESIGNED_EXPIRATION=3600

# S3 Object prefixes
S3_RESUME_PREFIX=resumes/
S3_FAISS_PREFIX=faiss_index/

# LOCAL AWS CREDENTIALS (Only needed if running locally against real AWS resources; NOT needed on EC2 with IAM role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- OPENAI / GENERATIVE AI CONFIGURATION ---
OPENAI_API_KEY=your-openai-api-key-here

# --- ML & EMBEDDING MODEL CONFIGURATION ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=data/faiss_index

# --- SECURITY & UPLOAD LIMITS ---
MAX_UPLOAD_SIZE_BYTES=10485760

# --- AUTH0 AUTHENTICATION (DUAL MODE) ---
# If credentials provided, real Auth0 verification runs; otherwise graceful Admin mock fallback
AUTH0_DOMAIN=dev-k05s7ohpn7hhcrxg.us.auth0.com
AUTH0_CLIENT_ID=kIhQb16gH2imFhq7OMwB7Ss6GYk2xwgX
AUTH0_API_AUDIENCE=https://api.airecruiter.local
